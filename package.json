{
  "name": "@coderbyheart/photos-editor",
  "version": "0.0.0-development",
  "description": "Editor for the data used for my photos page",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyheart/photos-editor.git"
  },
  "keywords": [
    "photo",
    "editor",
    "markdown"
  ],
  "author": "Markus Tacker <m@coderbyheart.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/coderbyheart/photos-editor/issues"
  },
  "homepage": "https://github.com/coderbyheart/photos-editor#readme",
  "scripts": {
    "server": "./node_modules/.bin/nodemon --optimize_for_size --max_old_space_size=920 --gc_interval=100 server/main.ts",
    "ui": "vite"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.3",
    "@bifravst/from-env": "4.0.0",
    "@bifravst/prettier-config": "2.0.0",
    "@preact/preset-vite": "2.10.6",
    "@swc/core": "1.16.2",
    "@types/js-yaml": "4.0.9",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bootstrap": "5.3.8",
    "chalk": "6.0.0",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "js-yaml": "5.4.1",
    "leaflet": "1.9.4",
    "lint-staged": "17.5.0",
    "nodemon": "3.1.14",
    "preact": "10.29.8",
    "preact-router": "4.1.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --ext .js,.ts,.jsx,.tsx"
    ],
    "*.{md,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config"
}
