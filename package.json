{
  "name": "@coderbyheart/photos-editor",
  "version": "0.0.0-development",
  "description": "Editor for the data used for my photos page",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyheart/photos-editor.git"
  },
  "keywords": [
    "photo",
    "editor",
    "markdown"
  ],
  "author": "Markus Tacker <m@coderbyheart.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/coderbyheart/photos-editor/issues"
  },
  "homepage": "https://github.com/coderbyheart/photos-editor#readme",
  "scripts": {
    "server": "./node_modules/.bin/nodemon --optimize_for_size --max_old_space_size=920 --gc_interval=100 server/main.ts",
    "ui": "vite"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "7.0.10",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/prettier-config": "1.1.17",
    "@preact/preset-vite": "2.10.5",
    "@swc/core": "1.15.30",
    "@types/js-yaml": "4.0.9",
    "@types/leaflet": "1.9.21",
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260425.1",
    "bootstrap": "5.3.8",
    "chalk": "5.6.2",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "js-yaml": "4.1.1",
    "leaflet": "1.9.4",
    "lint-staged": "16.4.0",
    "nodemon": "3.1.14",
    "preact": "10.29.1",
    "preact-router": "4.1.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --ext .js,.ts,.jsx,.tsx"
    ],
    "*.{md,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config"
}
